%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 60, "rankSpacing": 90}}}%%
flowchart TB
  %% Railway Project State / IaC architecture, optimized for non-overlapping rendering.

  subgraph Today[Today: SDK prototype proves the data flow]
    direction TB

    subgraph A[Authoring]
      direction LR
      TS["TypeScript IaC\n.railway/railway.ts"]
      Other["Web / CLI / Templates\nMCP / Diagnosis / Agents"]
    end

    subgraph B[Shared project-state model]
      direction LR
      Eval["Evaluate / normalize\nread-only"]
      Graph["RailwayGraph v1\ndeterministic project intent"]
      ChangeSet["RailwayChangeSet v0\nintent-level changes"]
    end

    subgraph Side[Graph consumers]
      direction LR
      Types["Generated types\ngraph-types.d.ts"]
      Runtime["Runtime context\nproject.service('api')"]
    end

    subgraph C[Current bridge]
      direction LR
      Adapter["Prototype adapter\nChangeSet → EnvironmentConfig patch"]
      Patch["EnvironmentConfig patch\nexisting substrate shape"]
    end

    subgraph D[Backboard today]
      direction LR
      Stage["environmentStageChanges"]
      Commit["environmentPatchCommitStaged"]
      Apply["Provision / deploy\nexisting workflows"]
    end
  end

  subgraph Future[Future direction]
    direction LR
    Protocol["One project-state protocol\nfor all producers"]
    Receiver["Backboard accepts RailwayChangeSet\nvalidate + authorize + realize"]
  end

  TS --> Eval --> Graph --> ChangeSet --> Adapter --> Patch --> Stage --> Commit --> Apply
  Other -. "may emit graph or changes" .-> ChangeSet
  Graph --> Types
  Graph --> Runtime

  Protocol -. "standardizes" .-> ChangeSet
  ChangeSet -. "future direct receiver" .-> Receiver
  Receiver -. "realizes through platform workflows" .-> Apply

  classDef author fill:#111827,stroke:#374151,color:#fff
  classDef model fill:#0f766e,stroke:#14b8a6,color:#fff
  classDef bridge fill:#92400e,stroke:#f59e0b,color:#fff
  classDef backboard fill:#1d4ed8,stroke:#60a5fa,color:#fff
  classDef future fill:#581c87,stroke:#c084fc,color:#fff

  class TS,Other author
  class Eval,Graph,Types,Runtime,ChangeSet model
  class Adapter,Patch bridge
  class Stage,Commit,Apply backboard
  class Receiver,Protocol future
