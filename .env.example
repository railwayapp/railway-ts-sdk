# A project token (Project Settings → Tokens) is enough on its own: the SDK reads
# its project and environment from the token.
RAILWAY_TOKEN=
# Or an account/workspace token, which also needs RAILWAY_ENVIRONMENT_ID.
RAILWAY_API_TOKEN=
# Optional with RAILWAY_TOKEN; overrides the token's environment.
RAILWAY_ENVIRONMENT_ID=
RAILWAY_PROJECT_ID=
RAILWAY_GRAPHQL_ENDPOINT=https://backboard.railway-develop.com/graphql/v2
