{
  "version": 0,
  "changes": [
    {
      "kind": "variable.set",
      "address": "service.backend",
      "variable": "REDIS_URL",
      "after": {
        "type": "reference",
        "resource": "database.api-cache",
        "output": "REDIS_URL"
      },
      "path": "resources.service.backend.variables.REDIS_URL",
      "summary": "Set variable backend.REDIS_URL",
      "severity": "safe",
      "deployEffect": "deploy"
    },
    {
      "kind": "resource.create",
      "address": "service.frontend",
      "resource": {
        "address": "service.frontend",
        "type": "service",
        "kind": "github",
        "name": "frontend",
        "source": {
          "type": "github",
          "repo": "futurepastori/todo-iac-example",
          "branch": "main",
          "rootDirectory": "apps/frontend"
        },
        "build": {
          "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter frontend build"
        },
        "deploy": {
          "startCommand": "pnpm --filter frontend preview -- --port ${PORT:-4173}",
          "preDeployCommand": [
            "pnpm --filter frontend generate-sitemap"
          ],
          "multiRegionConfig": {
            "us-west1": {
              "numReplicas": 3
            },
            "europe-west4": {
              "numReplicas": 2
            }
          }
        },
        "variables": {
          "VITE_API_URL": {
            "type": "literal",
            "value": "https://${{backend.RAILWAY_PUBLIC_DOMAIN}}"
          }
        }
      },
      "path": "resources.service.frontend",
      "summary": "Create service frontend",
      "severity": "safe",
      "deployEffect": "deploy"
    }
  ],
  "diagnostics": []
}