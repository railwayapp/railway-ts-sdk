{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "codegen.ts",
    "examples/**/*.ts",
    "src/graphql/operations/**/*.graphql",
    "*.config.ts"
  ],
  "publicPackages": [
    "railway"
  ],
  "ignorePatterns": [
    "src/generated/graphql.ts"
  ],
  "duplicates": {
    "ignore": [
      "src/generated/graphql.ts",
      "src/iac/**",
      "tests/**"
    ]
  },
  "health": {
    "ignore": [
      "src/generated/graphql.ts",
      "src/iac/**"
    ]
  },
  "rules": {
    "unused-class-members": "off"
  }
}
